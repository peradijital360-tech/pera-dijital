# ============================================================
# Pera Dijital — Apache config for shared hosting (cPanel)
# ============================================================

Options -Indexes
DirectorySlash On

# The pages are PHP now. index.html stays in the list only so a stray static
# file would still be served if one is ever dropped in.
DirectoryIndex index.php index.html

ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. OLD WORDPRESS URLS -> NEW PAGES.
  #    Every old address goes straight to the canonical https://www URL in
  #    one hop (these run before the HTTPS and www rules), query string
  #    dropped, case-insensitive, trailing slash optional. Patterns are
  #    anchored, so e.g. /referanslar/ does not catch /referanslarimiz/.
  #    /hakkimizda/ exists on both sites and needs no rule.
  #    The blog is not carried over: its category, index and single post
  #    all go to the homepage.
  RewriteRule ^category/yapay-zeka(/.*)?$ https://www.peradijital.com.tr/ [R=301,L,NC,QSD]
  RewriteRule ^blog(/.*)?$ https://www.peradijital.com.tr/ [R=301,L,NC,QSD]
  RewriteRule ^yapay-zeka-ve-dijital-pazarlamanin-gelecegi-2025-ve-sonrasi/?$ https://www.peradijital.com.tr/ [R=301,L,NC,QSD]
  RewriteRule ^teklif-al/?$ https://www.peradijital.com.tr/ [R=301,L,NC,QSD]
  RewriteRule ^web-tasarim/?$ https://www.peradijital.com.tr/cozumlerimiz/kurumsal-web-tasarim/ [R=301,L,NC,QSD]
  RewriteRule ^(e-ticaret|e-ticaret-sitesi|e-ticaret-web-sitesi-demo-talep-formu)/?$ https://www.peradijital.com.tr/cozumlerimiz/e-ticaret-site-kurulumu/ [R=301,L,NC,QSD]
  RewriteRule ^(google-reklamlari|sosyal-medya-reklamlari)/?$ https://www.peradijital.com.tr/cozumlerimiz/performans-reklam-yonetimi/ [R=301,L,NC,QSD]
  RewriteRule ^(referanslar|case-studies)/?$ https://www.peradijital.com.tr/referanslarimiz/ [R=301,L,NC,QSD]

  # 1. Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 2. Force the www host, matching every <link rel="canonical">.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # 2b. /robots.txt is generated by robots.php so it follows SITE_ENV
  #     (assets/inc/config.local.php): staging disallows everything, live
  #     allows crawling and lists the sitemap. There is no static robots.txt.
  RewriteRule ^robots\.txt$ robots.php [END]

  # 3. The URLs are directory-based and extensionless. Anything that reaches
  #    the same content by a second path is redirected to the one canonical
  #    form, so nothing is indexed twice.

  # 3a. /path/index.html and /path/index.php -> /path/
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(html|php)[\s?] [NC]
  RewriteRule ^(.*/)?index\.(html|php)$ /%1 [R=301,L]

  # 3b. The service page moved from a .html file to a directory.
  #     Old address kept alive for anything already linking to it.
  RewriteRule ^cozumlerimiz/performans-reklam-yonetimi\.html$ \
    /cozumlerimiz/performans-reklam-yonetimi/ [R=301,L]

  # 3b-2. The service page was narrowed to corporate sites and re-slugged.
  #       Old address kept alive for anything already linking to it.
  RewriteRule ^cozumlerimiz/web-tasarim/?$ \
    /cozumlerimiz/kurumsal-web-tasarim/ [R=301,L]

  # 3c. Any other stray .html or .php request for a page that now lives in a
  #     directory of the same name. send.php is the one .php that is a real
  #     endpoint rather than a page, so it is excluded.
  RewriteCond %{REQUEST_URI} !^/send\.php$
  RewriteCond %{DOCUMENT_ROOT}/$1/index.php -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)\.(html|php)$ /$1/ [R=301,L]
</IfModule>

# ============================================================
# Compression
# ============================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ============================================================
# Caching. Assets are content-addressed by edit, so they cache hard;
# HTML must always revalidate or a redeploy would not be seen.
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|svg|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
